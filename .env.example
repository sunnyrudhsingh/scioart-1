# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project → Settings → Environment Variables).
# All are optional. See README.md.

# Full public address of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Supabase, for saving Ask an Expert questions. Leave empty for demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
